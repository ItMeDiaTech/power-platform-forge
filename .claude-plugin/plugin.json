{
  "name": "power-platform-forge",
  "version": "0.3.1",
  "description": "Terminal tooling for Power BI, Power Apps and SharePoint: a JSON-emitting CLI harness, skills, plain-English change notices and a local MCP server, so an agent can inventory, inspect, edit, publish and refresh work assets without driving a browser.",
  "author": {
    "name": "Austin Jordan",
    "url": "https://github.com/ItMeDiaTech"
  },
  "homepage": "https://github.com/ItMeDiaTech/power-platform-forge",
  "repository": "https://github.com/ItMeDiaTech/power-platform-forge",
  "keywords": [
    "power-platform",
    "power-bi",
    "power-apps",
    "sharepoint",
    "dataverse",
    "fabric",
    "cli",
    "mcp"
  ],
  "mcpServers": {
    "ppx": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/scripts/ppx",
        "--offline",
        "ppx-mcp"
      ],
      "env": {
        "PPX_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
